{
  "events": {
    "E_OPEN_ANY_LOCKED_GATE": {
      "when": [
        { "type": "fact_is_true", "key": "world.alley.locked" }
      ],
      "do": [
        { "type": "set_fact", "key": "world.alley.locked", "value": false },
        { "type": "message", "text": "你轉開了鎖。" },
        { "type": "add_exit", "from_room": "$here", "dir": "east", "to_room": "store" },
        { "type": "consume_item" }
      ],
      "priority": 5
    },

    "E_OPEN_BRONZE_ONLY": {
      "when": [
        { "type": "room_tag_any", "tags": ["bronze_lock"] }
      ],
      "do": [
        { "type": "set_fact", "key": "world.alley.locked", "value": false },
        { "type": "message", "text": "青銅鎖發出清脆一聲，門開了。" },
        { "type": "add_exit", "from_room": "$here", "dir": "east", "to_room": "store" },
        { "type": "consume_item" }
      ],
      "priority": 10
    },

    "E_TALK_INNKEEPER_ONCE": {
      "when": [
        { "type": "fact_is_false", "key": "event.innkeeper.hinted" }
      ],
      "do": [
        { "type": "message", "text": "老闆：東邊巷子好像被鎖住了…" },
        { "type": "set_fact", "key": "event.innkeeper.hinted", "value": true }
      ],
      "priority": 10
    },

    "E_TALK_ANY_TRADER_OPENS_SHOP": {
      "when": [],
      "do": [
        { "type": "message", "text": "[交易] 介面尚未實作（之後會加）" }
      ],
      "priority": 0
    },

    "E_GIVE_COIN_TO_INNKEEPER": {
      "when": [
        { "type": "target_is", "id": "innkeeper" }
      ],
      "do": [
        { "type": "message", "text": "老闆：謝啦！這是你的通行證。" },
        { "type": "give_item", "to": "actor", "item": "permit" },
        { "type": "consume_item" }
      ],
      "priority": 10
    },
	"E_PAY_INN_5G": {
      "when": [ { "type": "gold_at_least", "min": 5 } ],
      "do": [
        { "type": "spend_gold", "amount": 5 },
        { "type": "message", "text": "你付了 5G，在旅館好好睡了一晚。" },
        { "type": "heal_hp", "amount": 999 } 
      ],
      "priority": 10
    }
  }
}